{
  "id": "legal_page",
  "label": "Page légale",
  "repeatable": true,
  "status": true,
  "format": "page",
  "json": {
    "Page": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "Adresse de la page (ne pas modifier)",
          "placeholder": "ex. terrains"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Titre",
          "placeholder": "ex. Mentions légales",
          "single": "heading1"
        }
      },
      "content": {
        "type": "StructuredText",
        "config": {
          "label": "Contenu",
          "placeholder": "",
          "multi": "heading2,heading3,paragraph,strong,em,hyperlink,list-item,o-list-item",
          "allowTargetBlank": true
        }
      }
    },
    "SEO": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Titre Google",
          "placeholder": "60 caractères max."
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Description Google",
          "placeholder": "155 caractères max."
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Image de partage (réseaux sociaux)",
          "constraint": {},
          "thumbnails": []
        }
      },
      "noindex": {
        "type": "Boolean",
        "config": {
          "label": "Masquer de Google",
          "default_value": true,
          "placeholder_true": "Oui",
          "placeholder_false": "Non"
        }
      }
    }
  }
}
