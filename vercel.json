{
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"v2\" ] && exit 0 || exit 1",
  "headers": [
    {
      "source": "/(.*\\.webp|.*\\.jpg|.*\\.jpeg|.*\\.png|.*\\.svg|.*\\.ico|.*\\.woff2|.*\\.otf|.*\\.mp4|.*\\.webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
