{
  "id": "logos",
  "type": "SharedSlice",
  "name": "Logos",
  "description": "Partenaires ou clients.",
  "variations": [
    {
      "id": "partners",
      "name": "Partenaires",
      "description": "Cartes avec logo, nom, description et lien.",
      "imageUrl": "",
      "docURL": "...",
      "version": "initial",
      "primary": {
        "badge": {
          "type": "Text",
          "config": {
            "label": "Pastille au-dessus du titre",
            "placeholder": "ex. Restaurant & Bar"
          }
        },
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "Titre",
            "placeholder": "",
            "single": "heading2"
          }
        },
        "items": {
          "type": "Group",
          "config": {
            "label": "Partenaires",
            "repeat": true,
            "fields": {
              "logo": {
                "type": "Image",
                "config": {
                  "label": "Logo",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "name": {
                "type": "Text",
                "config": {
                  "label": "Nom",
                  "placeholder": ""
                }
              },
              "description": {
                "type": "Text",
                "config": {
                  "label": "Description",
                  "placeholder": ""
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Site du partenaire",
                  "placeholder": "",
                  "select": "web",
                  "allowTargetBlank": true
                }
              }
            }
          }
        }
      },
      "items": {}
    },
    {
      "id": "marquee",
      "name": "Clients (défilement)",
      "description": "Ex. « Ils nous font confiance » : deux rangées de logos qui défilent.",
      "imageUrl": "",
      "docURL": "...",
      "version": "initial",
      "primary": {
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "Titre",
            "placeholder": "",
            "single": "heading2"
          }
        },
        "items": {
          "type": "Group",
          "config": {
            "label": "Clients",
            "repeat": true,
            "fields": {
              "logo": {
                "type": "Image",
                "config": {
                  "label": "Logo",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "name": {
                "type": "Text",
                "config": {
                  "label": "Nom",
                  "placeholder": ""
                }
              },
              "row": {
                "type": "Select",
                "config": {
                  "label": "Rangée",
                  "options": [
                    "1",
                    "2"
                  ],
                  "default_value": "1"
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}
