{
  "id": "text_image",
  "type": "SharedSlice",
  "name": "Texte + visuel",
  "description": "Un titre, un texte et des boutons à côté d'une photo, de trois photos ou d'une vidéo verticale.",
  "variations": [
    {
      "id": "default",
      "name": "Texte + photo",
      "description": "Ex. « Notre histoire », « Demandez un devis ».",
      "imageUrl": "",
      "docURL": "...",
      "version": "initial",
      "primary": {
        "badge": {
          "type": "Text",
          "config": {
            "label": "Pastille au-dessus du titre",
            "placeholder": "ex. Restaurant & Bar"
          }
        },
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "Titre",
            "placeholder": "Le texte en gras s'affiche en orange",
            "single": "heading2,strong"
          }
        },
        "body": {
          "type": "StructuredText",
          "config": {
            "label": "Texte",
            "placeholder": "Les listes à puces s'affichent avec des coches orange",
            "multi": "paragraph,strong,em,hyperlink,list-item",
            "allowTargetBlank": true
          }
        },
        "buttons": {
          "type": "Group",
          "config": {
            "label": "Boutons",
            "repeat": true,
            "fields": {
              "link": {
                "type": "Link",
                "config": {
                  "label": "Lien et texte du bouton",
                  "placeholder": "Page du site, adresse web, téléphone (tel:…) ou PDF",
                  "allowTargetBlank": true,
                  "allowText": true
                }
              },
              "style": {
                "type": "Select",
                "config": {
                  "label": "Style",
                  "options": [
                    "Orange (principal)",
                    "Contour",
                    "Lien texte"
                  ],
                  "default_value": "Orange (principal)"
                }
              }
            }
          }
        },
        "image": {
          "type": "Image",
          "config": {
            "label": "Photo",
            "constraint": {},
            "thumbnails": []
          }
        },
        "image_position": {
          "type": "Select",
          "config": {
            "label": "Photo à",
            "options": [
              "Droite",
              "Gauche"
            ],
            "default_value": "Droite"
          }
        },
        "image_format": {
          "type": "Select",
          "config": {
            "label": "Format de la photo",
            "options": [
              "Paysage",
              "Portrait"
            ],
            "default_value": "Paysage"
          }
        },
        "anchor": {
          "type": "Text",
          "config": {
            "label": "Ancre (facultatif)",
            "placeholder": "ex. demande → lien /page#demande"
          }
        }
      },
      "items": {}
    },
