{
  "id": "pricing",
  "type": "SharedSlice",
  "name": "Tarifs",
  "description": "Grille de prix des terrains ou liste de formules.",
  "variations": [
    {
      "id": "cards",
      "name": "Cartes de prix",
      "description": "Ex. « Location de terrains ». Une carte peut être mise en avant.",
      "imageUrl": "",
      "docURL": "...",
      "version": "initial",
      "primary": {
        "badge": {
          "type": "Text",
          "config": {
            "label": "Pastille au-dessus du titre",
            "placeholder": "ex. Restaurant & Bar"
          }
        },
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "Titre",
            "placeholder": "Le texte en gras s'affiche en orange",
            "single": "heading2,strong"
          }
        },
        "intro": {
          "type": "StructuredText",
          "config": {
            "label": "Texte d'introduction",
            "placeholder": "",
            "single": "paragraph,strong,em,hyperlink",
            "allowTargetBlank": true
          }
        },
        "items": {
          "type": "Group",
          "config": {
            "label": "Tarifs",
            "repeat": true,
            "fields": {
              "label": {
                "type": "Text",
                "config": {
                  "label": "Nom",
                  "placeholder": "ex. Heures pleines"
                }
              },
              "detail": {
                "type": "Text",
                "config": {
                  "label": "Détail",
                  "placeholder": "ex. 12h-14h, 16h-22h et week-end"
                }
              },
              "price": {
                "type": "Text",
                "config": {
                  "label": "Prix",
                  "placeholder": "ex. 15 €"
                }
              },
              "unit": {
                "type": "Text",
                "config": {
                  "label": "Unité",
                  "placeholder": "ex. / pers / heure"
                }
              },
              "highlight": {
                "type": "Boolean",
                "config": {
                  "label": "Mettre en avant (bordure orange)",
                  "default_value": false,
                  "placeholder_true": "Oui",
                  "placeholder_false": "Non"
                }
              },
              "highlight_label": {
                "type": "Text",
                "config": {
                  "label": "Mention au-dessus (facultatif)",
                  "placeholder": "ex. Le plus populaire"
                }
              }
            }
          }
        },
        "note": {
          "type": "StructuredText",
          "config": {
            "label": "Note sous les prix",
            "placeholder": "",
            "single": "paragraph,strong,em,hyperlink",
            "allowTargetBlank": true
          }
        },
        "buttons": {
          "type": "Group",
          "config": {
            "label": "Boutons",
            "repeat": true,
            "fields": {
              "link": {
                "type": "Link",
                "config": {
                  "label": "Lien et texte du bouton",
                  "placeholder": "Page du site, adresse web, téléphone (tel:…) ou PDF",
                  "allowTargetBlank": true,
                  "allowText": true
                }
              },
              "style": {
                "type": "Select",
                "config": {
                  "label": "Style",
                  "options": [
                    "Orange (principal)",
                    "Contour",
                    "Lien texte"
                  ],
                  "default_value": "Orange (principal)"
                }
              }
            }
          }
        }
      },
      "items": {}
    },
