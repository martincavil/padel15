{
  "id": "cta_banner",
  "type": "SharedSlice",
  "name": "Appel à l'action",
  "description": "Un encadré avec titre, texte et boutons.",
  "variations": [
    {
      "id": "default",
      "name": "Simple",
      "description": "Ex. « Venez découvrir Padel 15 ».",
      "imageUrl": "",
      "docURL": "...",
      "version": "initial",
      "primary": {
        "title": {
          "type": "StructuredText",
          "config": {
            "label": "Titre",
            "placeholder": "Le texte en gras s'affiche en orange",
            "single": "heading2,strong"
          }
        },
        "text": {
          "type": "StructuredText",
          "config": {
            "label": "Texte (facultatif)",
            "placeholder": "",
            "single": "paragraph,strong,em,hyperlink",
            "allowTargetBlank": true
          }
        },
        "buttons": {
          "type": "Group",
          "config": {
            "label": "Boutons",
            "repeat": true,
            "fields": {
              "link": {
                "type": "Link",
                "config": {
                  "label": "Lien et texte du bouton",
                  "placeholder": "Page du site, adresse web, téléphone (tel:…) ou PDF",
                  "allowTargetBlank": true,
                  "allowText": true
                }
              },
              "style": {
                "type": "Select",
                "config": {
                  "label": "Style",
                  "options": [
                    "Orange (principal)",
                    "Contour",
                    "Lien texte"
                  ],
                  "default_value": "Orange (principal)"
                }
              }
            }
          }
        }
      },
      "items": {}
    },
